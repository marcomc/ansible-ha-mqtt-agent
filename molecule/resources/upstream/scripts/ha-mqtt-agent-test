#!/usr/bin/env bash
set -o errexit -o nounset -o pipefail

case "${1:-}" in
  --version)
    printf '%s\n' 'ha-mqtt-agent 0.0.0-test'
    ;;
  --config)
    if [[ "${3:-}" != 'doctor' || "${4:-}" != '--mqtt' ]]; then
      printf '%s\n' 'fixture doctor requires --mqtt' >&2
      exit 2
    fi
    printf '%s\n' 'MQTT connection healthy'
    ;;
  run)
    exec /bin/sleep infinity
    ;;
  *)
    printf '%s\n' 'fixture command completed'
    ;;
esac
