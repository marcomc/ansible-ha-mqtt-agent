#!/usr/bin/env bash
set -o errexit -o nounset -o pipefail

case "${1:-}" in
  --version)
    printf '%s\n' 'ha-mqtt-agent 0.0.0-test'
    ;;
  --config)
    if [[ "${3:-}" != 'doctor' || "${4:-}" != '--mqtt' ]]; then
      printf '%s\n' 'fixture doctor requires --mqtt' >&2
      exit 2
    fi
    printf '%s\n' 'doctor' >> /tmp/ha-mqtt-agent-mqtt.log
    if [[ ! -r "${2}" ]]; then
      printf '%s\n' 'MQTT config is unreadable' >&2
      exit 1
    fi
    if grep --fixed-strings --quiet 'mqtt_host = "invalid.example.test"' "${2}"; then
      printf '%s\n' 'MQTT connection unhealthy' >&2
      exit 1
    fi
    printf '%s\n' 'MQTT connection healthy'
    ;;
  run)
    exec /bin/sleep infinity
    ;;
  *)
    printf '%s\n' 'fixture command completed'
    ;;
esac
